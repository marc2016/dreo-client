{
  "name": "dreo-client",
  "version": "0.1.0",
  "description": "Node.js and TypeScript client for Dreo smart devices",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "dreo": "./bin/dreo.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "dreo",
    "smart-home",
    "iot",
    "heater",
    "fan",
    "client",
    "iobroker",
    "homebridge"
  ],
  "author": "Marc Lammers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc2016/dreo-client.git"
  },
  "bugs": {
    "url": "https://github.com/marc2016/dreo-client/issues"
  },
  "homepage": "https://github.com/marc2016/dreo-client#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
